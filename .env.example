# SoloCRM Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI Compatible API Settings
# 支持 OpenAI / 通义千问 / 文心一言 等任何 OpenAI 兼容格式
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Speech-to-text / ASR Settings
# 默认可接 SiliconFlow 的 TeleAI/TeleSpeechASR
ASR_API_KEY=
ASR_API_BASE=https://api.siliconflow.cn/v1/audio/transcriptions
ASR_MODEL=TeleAI/TeleSpeechASR

# PostgreSQL Database Configuration
POSTGRES_USER=solocrm
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=solocrm
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your-secret-key-change-this-in-production

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# OpenClaw Integration (optional)
# Enable if you want to use this via OpenClaw IM
OPENCLAW_ENABLED=false

# Graph Memory
# Default graph memory uses PostgreSQL tables and works on the standard pgvector image.
# Set ENABLE_APACHE_AGE=true only after installing the Apache AGE extension in PostgreSQL.
ENABLE_APACHE_AGE=false
